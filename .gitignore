## .NET
bin/
obj/
*.user
*.suo
*.cache
# Legacy NuGet restore folder. Scoped to the solution root so it does not swallow
# the npm workspace at /packages (packages/shared, packages/ui are real source).
/packages/*.nupkg
*.nupkg
**/Properties/launchSettings.json

node_modules/
npm-debug.log*
.next
dist/
*.tsbuildinfo

docker-compose.override.yml
*.orig

.vs/
.vscode/
.idea/
*.swp
*.sln.docstates

.DS_Store
Thumbs.db

*.env
appsettings.Development.json
/.env.example

# Local environment overrides for the Next.js apps
.env*.local

# Production env files are NOT committed (TASK-004): the HTTPS base URL is
# injected at build/run time via secrets or a gitignored .env.production.
apps/*/.env.production

# TLS certificates - never commit private keys
infra/nginx/tls/certs/*
!infra/nginx/tls/certs/.gitkeep

# Kubernetes secrets - never commit real credentials
k8s/secret.yaml
helm/**/secrets.yaml

# Local tooling / scratch files - never commit
.claude/
claude.txt
apps/*/logs/

# Task tracker - kept local only, not committed
