{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "NotificationDb": "Host=localhost;Port=5432;Database=NotificationDb;Username=paymentswitch;Password="
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "IdentityService",
    "Audience": "PaymentSwitch",
    "AccessTokenExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000", "http://localhost:3001", "http://localhost:3002" ]
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "UserName": "",
    "Password": "",
    "ExchangeName": "notification.events"
  },
  "Merchant": {
    "BaseUrl": "http://merchant-api:8080"
  },
  "SignalR": {
    "RateLimit": {
      "Capacity": 10,
      "TokensPerSecond": 5
    }
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@paymentswitch.com",
    "FromName": "PaymentSwitch",
    "UseSsl": false
  },
  "Sms": {
    "Enabled": false,
    "Provider": "None"
  },
  "Retention": {
    "CleanupIntervalMinutes": 60,
    "BatchSize": 100,
    "MessageRetentionDays": 7,
    "BusinessRetentionDays": 90
  }
