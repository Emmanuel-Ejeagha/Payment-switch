<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>E2E.IntegrationTests</AssemblyName>
    <RootNamespace>E2E.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.3.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Each API assembly generates an internal global-namespace Program; alias
         each so WebApplicationFactory<X::Program> is unambiguous. -->
    <ProjectReference Include="..\..\..\src\Services\Identity\Identity.API\Identity.API.csproj">
      <Aliases>IdentityApi</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\..\src\Services\Merchant\Merchant.API\Merchant.API.csproj">
      <Aliases>MerchantApi</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\..\src\Services\Payment\Payment.API\Payment.API.csproj">
      <Aliases>PaymentApi</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\..\src\Services\Ledger\Ledger.API\Ledger.API.csproj">
      <Aliases>LedgerApi</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\..\src\Services\Notification\Notification.API\Notification.API.csproj">
      <Aliases>NotificationApi</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\..\src\Services\Settlement\Settlement.API\Settlement.API.csproj">
      <Aliases>SettlementApi</Aliases>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestSecrets.cs" Link="TestSecrets.cs" />
    <Compile Include="..\Shared\AssemblyInfo.cs" Link="AssemblyInfo.cs" />
  </ItemGroup>

</Project>