# Local development environment variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
#
# Generate secrets, e.g.:
#   openssl rand -base64 32

# ASP.NET Core environment. Production deployments MUST set Production:
# Development enables Swagger UI, localhost CORS origins, and simulated email.
# Compose defaults to Development when this is unset — never rely on that default
# for any internet-facing deployment.
ASPNETCORE_ENVIRONMENT=Development

JWT_SECRET=

# Dedicated inter-service token secret. MUST differ from JWT_SECRET so a
# user-secret compromise cannot forge service-to-service calls.
# Generate with: openssl rand -base64 32
SERVICE_TOKEN_SECRET=

# Optional: previous JWT signing key during a rotation dual-write window.
# Set JWT_SECRET to the NEW key and JWT_PREVIOUS_SECRET to the OLD key, redeploy,
# then clear JWT_PREVIOUS_SECRET after the window. See infra/secrets/rotate-jwt.sh.
JWT_PREVIOUS_SECRET=

# PostgreSQL superuser password for the paymentswitch user
POSTGRES_PASSWORD=

# RabbitMQ default credentials
RABBITMQ_DEFAULT_USER=paymentswitch
RABBITMQ_DEFAULT_PASS=

# Identity admin seed (used only at first startup to create the admin user)
SEED_ADMIN_EMAIL=admin@paymentswitch.com
SEED_ADMIN_PASSWORD=

# Comma-separated browser origins allowed by the CORS policy (all services).
# In production set this to the real HTTPS origin(s) ONLY, e.g.
# CORS_ALLOWED_ORIGINS=https://merchant.example.com,https://admin.example.com
# When empty, services fall back to the localhost dev origins.
CORS_ALLOWED_ORIGINS=

# Grafana (optional, defaults to admin if unset)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# AES-GCM key used to encrypt merchant webhook secrets at rest (TASK-006).
# Required by the Merchant service; any strong secret (>= 32 chars) works,
# e.g. openssl rand -base64 32.
WEBHOOK_SECRET_ENCRYPTION_KEY=

# SMTP relay for transactional email (Identity + Notification services).
# Leave SMTP_HOST empty to run in simulated-email mode (Development only);
# in Production SMTP_HOST must be set or email delivery fails loudly.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@paymentswitch.com
SMTP_FROM_NAME=PaymentSwitch

# SMS channel. No provider is implemented; keep SMS_ENABLED=false (default).
SMS_ENABLED=false

# Resend transactional email (Notification service, verification mail only).
# Leave RESEND_API_KEY empty for simulated-email mode (Development only);
# in Production it must be set or verification delivery fails loudly at startup.
# Create the key at https://resend.com/api-keys (starts with re_).
# Production delivery also requires a verified sender domain: Resend Dashboard
# -> Domains -> add the domain -> publish the SPF/DKIM/DMARC DNS records it
# shows -> use an address on that domain for RESEND_FROM_EMAIL below.
# Placeholder only — NEVER put a live key in this template.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@paymentswitch.com
RESEND_FROM_NAME=PaymentSwitch
RESEND_TIMEOUT_SECONDS=30

# Public origin (trusted frontend/API URL; https required in Production).
# Consumed as the verification-link origin (Notification link building +
# Identity startup validation), the password-reset origin, and the frontend
# API base URL. A single origin keeps all three consistent behind nginx.
FRONTEND_BASE_URL=http://localhost:3000

# Minimum seconds between verification emails for the same address (default 60).
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
